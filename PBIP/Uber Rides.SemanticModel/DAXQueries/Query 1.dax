// Welcome to DAX query view! Learn more about DAX queries at https://aka.ms/dax-queries.
// Right-click on tables, columns, or measures in the data pane to access quick queries, or ask Copilot for help writing DAX.

// Select "Run" to try this sample DAX query.
DEFINE
    /// Returns the top category label based on a supplied grouping column and value expression
    FUNCTION TopByValue =
    (
        pGroup : ANYREF EXPR,
        pValue : SCALAR VARIANT EXPR
    ) =>
    VAR __Summary =
        ADDCOLUMNS(
            ALL( pGroup ),
            "__Metric", CALCULATE( pValue )
        )
    VAR __TopRow =
        TOPN( 1, __Summary, [__Metric], DESC )
    RETURN
        MAXX( __TopRow, pGroup )
