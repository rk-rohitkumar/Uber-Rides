table _Calculations
	lineageTag: ef7af1f4-2030-4936-84ae-490063667ad8

	measure 'Non-Completed Bookings' = ```
			
			CALCULATE(
				[Total Bookings],
				'Rides'[Booking Status] <>  "Completed" 
			)
			```
		formatString: 0
		displayFolder: Bookings
		lineageTag: 9d38af6a-7a7e-4b55-b5e6-4dc4d2def093

	/// Short description: Distinct count of booking IDs.
	/// Purpose: Counts unique bookings in the current filter context.
	/// Notes:
	/// Uses DISTINCTCOUNT(Rides[Booking ID]).
	/// Respects page/report filters and slicers.
	/// If Booking ID is blank, blanks are counted once.
	/// Assumes each booking ID uniquely identifies a booking.
	measure 'Total Bookings' = DISTINCTCOUNT(Rides[Booking ID])
		formatString: #,0
		displayFolder: Bookings
		lineageTag: 432de796-06b5-4bc1-9694-78249376996d

	measure 'Total Booking Value' = ```
			
			
				SUM('Rides'[Booking Value])
			```
		formatString: "₹"#,0;#,0\ -"₹";"₹"#,0
		displayFolder: Revenue
		lineageTag: 5e777f0c-4d2d-4d12-8c8a-555c8e8476fd

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "TotalForSelectedCategory"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"mr-IN"}

	measure 'Non-Completion Rate' =
			DIVIDE(
				[Non-Completed Bookings],
				[Total Bookings]
			)
		formatString: 0%;-0%;0%
		displayFolder: Bookings
		lineageTag: 0155235a-9b05-4888-af40-793f3eeb013e

	measure 'Avg of Vehicle-Type Avg Ride Distance' = ```
			
			    AVERAGEX(
			        SUMMARIZE(Rides, Rides[Vehicle Type]),
			        CALCULATE(AVERAGE(Rides[Ride Distance]))
			    )
			
			
			```
		formatString: 0
		displayFolder: Distance
		lineageTag: 8865a0ad-a3ce-48e0-a9b9-225311746861

	measure 'Total Ride Distance (KM)' = SUM( Rides[Ride Distance] )
		formatString: #,0.0
		displayFolder: Distance
		lineageTag: 161c6916-9824-451a-9994-2f75c46a2951

	measure 'Avg Revenue per Completed Booking' =
			
			DIVIDE( [Total Booking Value], ([Total Bookings] - [Non-Completed Bookings] ) )
		formatString: "₹"#,0;#,0\ -"₹";"₹"#,0
		displayFolder: Revenue
		lineageTag: c3249050-529d-498f-944e-6daeca8a51d7

		annotation PBI_FormatHint = {"currencyCulture":"mr-IN"}

	measure 'Completed Bookings' = ```
			
			CALCULATE(
				[Total Bookings],
				'Rides'[Booking Status] =  "Completed" 
			)
			```
		formatString: 0
		displayFolder: Bookings
		lineageTag: 8d62b59d-0c37-4818-8587-8c6ca58cb111

	measure 'Completion Rate' =
			DIVIDE(
				[Completed Bookings],
				[Total Bookings]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Bookings
		lineageTag: 6caa1784-f18c-4a26-b823-76e6e8714561

	measure 'Total Booking value by pick up location' =
			
			CALCULATE( [Total Booking Value], USERELATIONSHIP( Locations[LocationKey], Rides[Pickup.LocationKey] ) )
		formatString: 0
		displayFolder: Revenue
		lineageTag: bb4388d0-25be-44b7-8813-76e47f2ee42b

	measure 'Region with maximum booking value' = ```
			
			
			VAR RegionTotals = 
			    -- Calculate Total Booking Value for every distinct Region
			    SUMMARIZE(
			        Locations, -- Assuming this is your Location table
			        Locations[Region],
			        "TotalBookingValue", SUM('Rides'[Booking Value]) -- Link to the Fact table
			    )
			
			VAR MaxBookingValue = 
			    -- Find the maximum Total Booking Value among all regions
			    MAXX(
			        RegionTotals,
			        [TotalBookingValue]
			    )
			
			VAR ResultRegion = 
			    -- Filter the table to find the Region(s) that match the Max Booking Value
			    MAXX(
			        RegionTotals,
			        IF(
			            [TotalBookingValue] = MaxBookingValue,
			            'Locations'[Region],
			            BLANK() -- Return blank for all others
			        )
			    )
			
			RETURN
			    -- Return the Region Name
			    ResultRegion
			
			```
		displayFolder: Revenue
		lineageTag: dd74a84d-9d74-414f-8b11-119d205eac26

	measure 'Completed Bookings Value' = ```
			
			CALCULATE(
				[Total Booking Value],
				'Rides'[Booking Status] =  "Completed" 
			)
			```
		formatString: 0
		displayFolder: Revenue
		lineageTag: dfc66cae-3bb7-4fe5-84e7-3a9f68c54084

	measure 'Top Region' = ```
			
			VAR __MaxBookings = 
			    CALCULATETABLE(
			        SUMMARIZE(
			            ALL('Locations'), -- Analyze ALL regions, ignoring any current filters on the Locations table
			            'Locations'[Region],
			            "Total Booking Value", SUM('Rides'[Booking Value]) -- Calculate total bookings for each region
			        )
			
			    )
			
			VAR __TopRegionRow = 
			    SELECTCOLUMNS(
			        TOPN(1, __MaxBookings, [Total Booking Value], DESC), -- Select the top row based on the calculated value
			        "Region", 'Locations'[Region]
			    )
			
			RETURN 
			    -- Return the name from that top row
			    MAXX(__TopRegionRow, [Region])
			```
		displayFolder: Revenue
		lineageTag: ce154716-ebf3-48ea-bf7b-1a913cc029cf

	measure 'Unique Customers' = DISTINCTCOUNT('Rides'[Customer ID])
		formatString: #,0
		displayFolder: Customer
		lineageTag: b074d4ec-bf16-4a9a-ac80-c0b0757e0490

	measure 'Avg Trips per Customer' = ```
			
			DIVIDE(
			    [Total Bookings], 
			    CALCULATE(DISTINCTCOUNT('Rides'[Customer ID]), 'Rides'[Booking Status] = "Completed")
			)
			```
		formatString: #,0.00
		displayFolder: Customer
		lineageTag: 5019c36c-3802-4eb2-a69c-3332618ba1b3

	measure 'Cancellation Rate by Payment Method' = ```
			
			DIVIDE(
			    [Non-Completed Bookings], 
			    CALCULATE([Total Bookings], ALL('Rides'[Payment Method])) 
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Bookings
		lineageTag: 6042037a-bfe0-4b92-ac77-a053b850350c

	measure 'Potential Revenue Lost (Cancelled)' =
			
			CALCULATE(
			    SUM('Rides'[Booking Value]),
			    'Rides'[Booking Status] <> "Completed"
			)
		formatString: #,0
		displayFolder: Revenue
		lineageTag: 5eb02bf6-eebe-4d8b-8d45-850c8d4ad7a7

	measure 'Revenue Loss Ratio' =
			
			DIVIDE(
			    [Potential Revenue Lost (Cancelled)],
			    [Total Booking Value]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Revenue
		lineageTag: 1f5f1403-c0f5-4b8c-aa27-fca6604e9231

	measure 'Avg Ride Distance per Completion (KM)' = ```
			
			DIVIDE(
			    [Total Ride Distance (KM)],
			    [Completed Bookings] 
			)
			```
		displayFolder: Distance
		lineageTag: cf856855-a855-4bed-9662-f33529ab5eb8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'title revenue loss ratio' = FORMAT( [Revenue Loss Ratio], "#0.0%" ) & " revenue lost due to cancellations"
		displayFolder: Revenue
		lineageTag: 2ac0b449-7e4f-4b3f-a2df-3762ba0b4dcc

	measure 'Top Region by booking value' = ```
			
			    TopByValue( Locations[Region], [Total Booking Value] )
			```
		displayFolder: Revenue
		lineageTag: 048bc05f-8271-4a5b-ae9b-d84e043aaeb2

	measure 'title Top Region by revenue loss ratio' = ```
			
			    TopByValue( Locations[Region], [Revenue Loss Ratio] ) & " has the highest revenue loss ratio"
			```
		displayFolder: Revenue
		lineageTag: 43d19fa2-4a6d-48ff-a3dd-c977b461fcdb

