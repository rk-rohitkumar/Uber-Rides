model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Transformations

	annotation PBI_QueryGroupOrder = 0

queryGroup Final

	annotation PBI_QueryGroupOrder = 1

queryGroup DataSources

	annotation PBI_QueryGroupOrder = 2

queryGroup Locations

	annotation PBI_QueryGroupOrder = 3

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 4

annotation PBI_QueryOrder = ["RidesSource","CleanedData","Locations","Location-Region-Latitude-Longitude","Locations_Blank","Location-Region-Latitude-Longitude (1)","DenormalisedData","EnrichedData","Rides","_Calculations","pRidesData","Profile_Locations","Profile_Rides","pLocationData","pLocationData1","DateTable"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["TMDLView_Desktop","DaxQueryView_Desktop","DevMode"]

ref table Locations
ref table Rides
ref table _Calculations
ref table Profile_Locations
ref table Profile_Rides
ref table DateTable

ref cultureInfo en-US

